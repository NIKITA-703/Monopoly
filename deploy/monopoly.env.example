# Production: /etc/monopoly.env (deploy/monopoly.service)
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
DATA_DIR=/var/lib/monopoly
LEGACY_SINGLE_ROOM=0
TURN_SECONDS=70
TURN_ACTION_SECONDS=30
TRADE_SECONDS=35
AUCTION_SECONDS=40
LOBBY_DISCONNECT_SECONDS=600
LOBBY_IDLE_SECONDS=900
DEBUG_ONLINE=0
AUDIT_LOG_MAX_BYTES=5242880
AUDIT_LOG_FILES=5
AUDIT_LOG_MAX_AGE_DAYS=14
