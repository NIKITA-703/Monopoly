[Unit]
Description=Monopoly Online
After=network.target

[Service]
Type=simple
User=monopoly
Group=monopoly
WorkingDirectory=/opt/monopoly
EnvironmentFile=/etc/monopoly.env
ExecStart=/usr/bin/node /opt/monopoly/server/index.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/monopoly

[Install]
WantedBy=multi-user.target
